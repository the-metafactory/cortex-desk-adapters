{
  "name": "cortex-desk-adapters",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Portable source adapters, writers and a parser for the Cortex Desk: commands that print or create Desk JSON. The commands that wrap the personal toolkit live in personal/.",
  "bin": {
    "desk-ics": "bin/desk-ics.ts",
    "desk-imap": "bin/desk-imap.ts",
    "desk-ntfy": "bin/desk-ntfy.ts",
    "desk-mail-move": "bin/desk-mail-move.ts",
    "desk-mail-trash": "bin/desk-mail-trash.ts",
    "desk-mail-draft": "bin/desk-mail-draft.ts",
    "desk-mail-report": "bin/desk-mail-report.ts",
    "desk-mail-invite": "bin/desk-mail-invite.ts",
    "desk-mail-send": "bin/desk-mail-send.ts",
    "desk-mail-dmarc": "bin/desk-mail-dmarc.ts",
    "desk-parse": "bin/desk-parse.ts",
    "desk-calendar-create": "bin/desk-calendar-create.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p personal"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "imapflow": "^1.1.1",
    "zod": "4.3.6"
  },
  "workspaces": [
    "personal"
  ]
}
